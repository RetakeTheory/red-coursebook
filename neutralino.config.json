{
  "applicationId": "net.reshi.redcoursebook",
  "applicationName": "红课题本",
  "description": "红课题本桌面练习与测试",
  "version": "1.2.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/site/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "dataLocation": "system",
  "storageLocation": "system",
  "logging": {"enabled": false, "writeToLogFile": false},
  "nativeAllowList": ["app.exit", "storage.getKeys", "storage.getData", "storage.setData", "window.beginDrag", "window.isMaximized", "window.maximize", "window.unmaximize", "window.minimize"],
  "modes": {
    "window": {
      "title": "红课题本",
      "width": 1240, "height": 810, "minWidth": 560, "minHeight": 460,
      "center": true, "resizable": true, "borderless": true,
      "icon": "/site/icon.png",
      "enableInspector": false, "exitProcessOnClose": false,
      "useSavedState": true, "useLogicalPixels": true, "newWindowPolicy": "custom"
    }
  },
  "cli": {
    "binaryName": "RedCoursebook", "resourcesPath": "/site/", "distributionPath": "/build/dist/",
    "clientLibrary": "/site/neutralino.js", "binaryVersion": "6.10.0", "clientVersion": "6.10.0"
  }
}
